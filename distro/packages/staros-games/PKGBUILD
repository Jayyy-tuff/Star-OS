# SPDX-License-Identifier: GPL-3.0-or-later
# Game Center (M0.5, ADR-0017): the games among the installed apps and
# Steam's installed games in one place, with GameMode. Built in CI by
# scripts/build-packages.sh from a tarball of the checked-out repository
# (ADR-0009). The version is fixed and bumped in reviewed changes. At run time
# StarOS.Shell comes from the ISO's shell tree.

pkgname=staros-games
pkgver=0.5.0
pkgrel=1
pkgdesc='Star OS Game Center'
arch=(x86_64)
url='https://github.com/Jayyy-tuff/Star-OS'
license=(GPL-3.0-or-later)
# No split debug package; no LTO for the static QML module library.
options=(!debug !lto)
depends=(
  gamemode
  gcc-libs
  glibc
  kconfig
  kio
  kservice
  qt6-base
  qt6-declarative
)
makedepends=(
  cmake
  extra-cmake-modules
  ninja
)
checkdepends=(
  desktop-file-utils
)
source=(star-os-src.tar.gz)
sha256sums=('SKIP')

build() {
  cmake -B build -S star-os-src/apps/games -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
