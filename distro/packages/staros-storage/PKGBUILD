# SPDX-License-Identifier: GPL-3.0-or-later
# Star Storage (M0.4, ADR-0011): sets up a disk that keeps the live system's
# changes, its privileged helper (run through pkexec) and its polkit action.
# Built in CI by scripts/build-packages.sh from a tarball of the checked-out
# repository (ADR-0009). The version is fixed and bumped in reviewed changes.
# At run time StarOS.Shell comes from the ISO's shell tree.

pkgname=staros-storage
pkgver=0.4.0
pkgrel=1
pkgdesc='Star OS persistent storage setup for the live medium'
arch=(x86_64)
url='https://github.com/Jayyy-tuff/Star-OS'
license=(GPL-3.0-or-later)
# No split debug package; no LTO for the static QML module library.
options=(!debug !lto)
depends=(
  e2fsprogs
  gcc-libs
  glibc
  polkit
  python
  qt6-base
  qt6-declarative
  qt6-svg
  staros-system
  systemd
  util-linux
)
makedepends=(
  cmake
  extra-cmake-modules
  ninja
)
checkdepends=(
  desktop-file-utils
)
source=(star-os-src.tar.gz)
sha256sums=('SKIP')

build() {
  cmake -B build -S star-os-src/apps/storage -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
