# Packages added to releng's list for milestone M0.2 (ADR-0008). One per line.
# Session: KWin and Plasma's session services; plasmashell hosts the Star OS
# shell packages. plasma-desktop provides the fallback shell package and kaccess.
kwin
plasma-workspace
plasma-desktop
kactivitymanagerd
layer-shell-qt
kitemmodels
xorg-xwayland
polkit-kde-agent
libkscreen
# Rendering: Mesa explicitly, so KWin's OpenGL path (llvmpipe without a GPU)
# does not depend on dependency resolution.
mesa
noto-fonts
# Applications in the curated M0.2 launcher catalogue.
konsole
systemsettings
kmenuedit
# Screen reader and audio.
orca
speech-dispatcher
python-gobject
pipewire
pipewire-pulse
wireplumber
# Star OS apps (M0.3, ADR-0009): built from distro/packages/ by
# scripts/build-packages.sh into the build-time repository [staros].
# staros-sunstore pulls flatpak.
staros-files
staros-sunstore
# M0.4 (docs/architecture/m04-apps-lens-storage-design.md): the StarOS.System
# QML module, and the preinstalled apps from the pinned snapshot. Firefox is
# the browser until the owner adds Moon Browser.
staros-system
firefox
vlc
okular
gwenview
ark
kwrite
kcalc
# Offline text recognition for Star Lens.
tesseract
tesseract-data-eng
